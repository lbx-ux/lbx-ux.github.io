---
// 返回顶部悬浮按钮（玻璃圆钮）
---
<button type="button" class="back-to-top glass" data-back-to-top aria-label="返回顶部">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="m5 12 7-7 7 7"></path>
    <path d="M12 19V5"></path>
  </svg>
</button>

<style>
  .back-to-top {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 40;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 16px;
    color: var(--fg-muted);
    opacity: 0;
    transform: translateY(16px);
    pointer-events: none;
    transition: opacity var(--tr-med), transform var(--tr-med), color var(--tr-fast),
      border-color var(--tr-fast);
  }
  .back-to-top.is-visible {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .back-to-top:hover {
    color: var(--accent-strong);
    border-color: rgba(129, 140, 248, 0.45);
  }
</style>
