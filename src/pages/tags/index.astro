---
import { getPublishedPosts, getTagMap } from '@/lib/content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';

const posts = await getPublishedPosts();
const tagMap = getTagMap(posts);
const max = Math.max(...tagMap.values(), 1);
---
<BaseLayout title="标签" description="按标签浏览全部文章主题。">
  <div class="container tags-page">
    <header class="page-head reveal">
      <p class="page-eyebrow">TAGS</p>
      <h1 class="page-title">标签</h1>
      <p class="page-sub">共 {tagMap.size} 个标签</p>
    </header>

    <div class="tag-cloud reveal" data-stagger>
      {
        [...tagMap.entries()].map(([tag, count], i) => (
          <a
            class="tag-card glass glass-lift"
            href={`/tags/${tag}/`}
            style={`--w: ${0.8 + (count / max) * 0.6}; transition-delay: ${i * 30}ms;`}
          >
            <Icon name="tag" size={15} />
            <span class="tag-name" style={`font-size: calc(1rem * var(--w));`}>{tag}</span>
            <span class="tag-count">{count}</span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .page-head {
    margin-bottom: var(--space-6);
  }
  .page-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.32em;
    color: var(--accent);
    margin: 0 0 12px;
  }
  .page-title {
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 700;
  }
  .page-sub {
    margin: 12px 0 0;
    color: var(--fg-muted);
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .tag-card {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 18px;
    border-radius: 16px;
    color: var(--fg-muted);
    cursor: pointer;
  }
  .tag-card:hover {
    color: var(--accent-strong);
  }
  .tag-name {
    font-weight: 600;
  }
  .tag-count {
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 22px;
    padding: 0 7px;
    border-radius: 999px;
    background: rgba(129, 140, 248, 0.16);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-strong);
  }
</style>
