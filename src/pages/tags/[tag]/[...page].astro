---
import { getPublishedPosts } from '@/lib/content';
import { estimateReadingTime } from '@/lib/readingTime';
import { POSTS_PER_PAGE } from '@/consts';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostCard from '@/components/PostCard.astro';
import Pagination from '@/components/Pagination.astro';

export async function getStaticPaths({ paginate }: import('astro').APIContext) {
  const posts = await getPublishedPosts();
  const tags = new Set(posts.flatMap((p) => p.data.tags));
  return [...tags].flatMap((tag) =>
    paginate(
      posts.filter((p) => p.data.tags.includes(tag)),
      {
        params: { tag },
        pageSize: POSTS_PER_PAGE,
      },
    ),
  );
}

const { page } = Astro.props;
const tag = Astro.params.tag as string;
const posts = page.data.map((p) => ({ ...p, readingMinutes: estimateReadingTime(p.body ?? '') }));
---
<BaseLayout title={`标签：${tag}`} description={`标签「${tag}」下的全部文章，共 ${page.total} 篇。`}>
  <div class="container tag-page">
    <header class="page-head reveal">
      <p class="page-eyebrow">TAG</p>
      <h1 class="page-title">#{tag}</h1>
      <p class="page-sub">
        共 {page.total} 篇 · <a href="/tags/" class="back-tags">全部标签</a>
      </p>
    </header>

    <div class="post-grid" data-stagger>
      {posts.map((post) => <PostCard post={post} />)}
    </div>

    {page.lastPage > 1 && (
      <Pagination current={page.currentPage} total={page.lastPage} baseUrl={`/tags/${tag}/`} />
    )}
  </div>
</BaseLayout>

<style>
  .page-head {
    margin-bottom: var(--space-6);
  }
  .page-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.32em;
    color: var(--accent);
    margin: 0 0 12px;
  }
  .page-title {
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 700;
  }
  .page-sub {
    margin: 12px 0 0;
    color: var(--fg-muted);
  }
  .back-tags {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
  }

  @media (max-width: 767px) {
    .post-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
