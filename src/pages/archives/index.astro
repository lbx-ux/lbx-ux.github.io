---
import { getPublishedPosts, groupByYear, formatDate } from '@/lib/content';
import { estimateReadingTime } from '@/lib/readingTime';
import BaseLayout from '@/layouts/BaseLayout.astro';

const posts = (await getPublishedPosts()).map((p) => ({
  ...p,
  readingMinutes: estimateReadingTime(p.body ?? ''),
}));
const byYear = groupByYear(posts);
const years = [...byYear.keys()].sort((a, b) => b - a);
const totalMinutes = posts.reduce((sum, p) => sum + p.readingMinutes, 0);
---
<BaseLayout
  title="归档"
  description={`全部文章归档：共 ${posts.length} 篇，按年份分组浏览。`}
>
  <div class="container archives-page">
    <header class="page-head reveal">
      <p class="page-eyebrow">ARCHIVES</p>
      <h1 class="page-title">归档</h1>
      <p class="page-sub">
        共 {posts.length} 篇文章 · 约 {totalMinutes} 分钟的阅读旅程
      </p>
    </header>

    {
      years.map((year) => (
        <section class="year-block reveal">
          <h2 class="year-heading">
            <span class="year-num">{year}</span>
            <span class="year-count">{byYear.get(year)!.length} 篇</span>
          </h2>
          <div class="timeline">
            {byYear.get(year)!.map((post) => (
              <div class="timeline-item">
                <a class="archive-item glass glass-lift" href={`/posts/${post.id}/`}>
                  <time class="archive-date" datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' })}
                  </time>
                  <span class="archive-title">{post.data.title}</span>
                  <span class="archive-tags">{post.data.tags.slice(0, 2).join(' / ')}</span>
                </a>
              </div>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .archives-page {
    max-width: 880px;
  }
  .page-head {
    margin-bottom: var(--space-6);
  }
  .page-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.32em;
    color: var(--accent);
    margin: 0 0 12px;
  }
  .page-title {
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 700;
  }
  .page-sub {
    margin: 12px 0 0;
    color: var(--fg-muted);
  }

  .year-block {
    margin-bottom: var(--space-6);
  }
  .year-heading {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 20px;
  }
  .year-num {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    font-weight: 700;
    background: linear-gradient(120deg, var(--fg), var(--accent-strong));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .year-count {
    font-size: 0.875rem;
    color: var(--fg-faint);
  }

  .archive-item {
    display: grid;
    grid-template-columns: 56px 1fr auto;
    align-items: center;
    gap: 18px;
    padding: 14px 20px;
    border-radius: 14px;
    cursor: pointer;
  }
  .archive-date {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--fg-faint);
  }
  .archive-title {
    font-weight: 600;
    font-size: 0.9688rem;
    line-height: 1.5;
  }
  .archive-tags {
    font-size: 0.75rem;
    color: var(--fg-faint);
    font-family: var(--font-mono);
  }

  @media (max-width: 639px) {
    .archive-item {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .archive-tags {
      display: none;
    }
  }
</style>
