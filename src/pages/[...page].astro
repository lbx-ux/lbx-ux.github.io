---
import { getPublishedPosts, formatDate } from '@/lib/content';
import { estimateReadingTime } from '@/lib/readingTime';
import { buildSeriesMap } from '@/lib/series';
import PostCard from '@/components/PostCard.astro';
import Pagination from '@/components/Pagination.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { SITE_TITLE, SITE_DESCRIPTION, POSTS_PER_PAGE } from '@/consts';

export async function getStaticPaths({ paginate }: import('astro').GetStaticPathsOptions) {
  const posts = await getPublishedPosts();
  return paginate(posts, { pageSize: POSTS_PER_PAGE });
}

const { page } = Astro.props;
// paginate 序列化只保留原始 entry，阅读时长在渲染期重算
const posts = page.data.map((p) => ({ ...p, readingMinutes: estimateReadingTime(p.body ?? '') }));
const featured = posts[0];
const rest = posts.slice(1);
const isFirstPage = page.currentPage === 1;

// 首页专栏区：全量文章分组，取最近更新的 4 个
const allPosts = isFirstPage
  ? (await getPublishedPosts()).map((p) => ({ ...p, readingMinutes: estimateReadingTime(p.body ?? '') }))
  : [];
const allSeries = isFirstPage ? buildSeriesMap(allPosts) : [];
const homeSeries = allSeries.slice(0, 4);
---
<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  {isFirstPage && (
    <section class="hero container" data-hero>
      <p class="hero-eyebrow reveal" data-hero-eyebrow>PERSONAL BLOG</p>
      <h1 class="hero-title" data-hero-title>
        记录、思考、<br />与<em class="grad-text">技术</em>同行。
      </h1>
      <p class="hero-sub" data-hero-sub>
        {SITE_DESCRIPTION}
      </p>

      <div class="hero-actions" data-hero-card>
        <a class="btn-primary" href="#posts">开始阅读</a>
        <a class="btn-ghost glass" href="/about/">关于我</a>
      </div>

      <div class="hero-stats glass glass-sheen" data-hero-card>
        <div class="stat">
          <span class="stat-num">{page.total}+</span>
          <span class="stat-label">篇文章</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num">{allSeries.length}</span>
          <span class="stat-label">个专栏</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num">∞</span>
          <span class="stat-label">好奇心</span>
        </div>
      </div>
    </section>
  )}

  <section class="container posts-section" id="posts">
    <div class="section-head reveal">
      <h2 class="section-title">最新文章</h2>
      <button type="button" class="see-all see-all-btn" data-search-open title="任意页面按 Ctrl+K 呼出搜索">
        全站搜索 <kbd class="see-all-kbd">Ctrl K</kbd> →
      </button>
    </div>

    <div class="post-grid" data-stagger>
      {
        isFirstPage && featured && (
          <div class="span-2">
            <PostCard post={featured} featured />
          </div>
        )
      }
      {rest.map((post) => <PostCard post={post} />)}
    </div>

    {page.lastPage > 1 && <Pagination current={page.currentPage} total={page.lastPage} baseUrl="/" />}
  </section>

  {
    isFirstPage && homeSeries.length > 0 && (
      <section class="container series-section reveal">
        <div class="section-head">
          <h2 class="section-title">技术专栏</h2>
          <a class="see-all" href="/series/">全部专栏 →</a>
        </div>
        <div class="home-series-grid" data-stagger>
          {
            homeSeries.map((s) => (
              <a class="hs-card glass glass-lift" href={`/series/${s.slug}/`}>
                <div class="hs-head">
                  <span class="hs-icon"><Icon name="layers" size={16} /></span>
                  <span class="hs-count">{s.posts.length} 篇</span>
                </div>
                <h3 class="hs-name">{s.name}</h3>
                <p class="hs-latest">最近：{s.posts[0].data.title}</p>
                <span class="hs-date">{formatDate(s.lastUpdated)}</span>
              </a>
            ))
          }
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: clamp(24px, 6vh, 72px) 0 clamp(40px, 8vh, 96px);
    max-width: 860px;
    margin-inline: auto;
    text-align: center;
  }
  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.32em;
    color: var(--accent);
    margin: 0 0 20px;
  }
  .hero-title {
    font-size: clamp(2.4rem, 6.5vw, 4.2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    perspective: 600px;
  }
  .hero-title em {
    font-style: normal;
  }
  .hero-sub {
    margin: 24px auto 0;
    max-width: 560px;
    color: var(--fg-muted);
    font-size: 1.0625rem;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    margin-top: 36px;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 13px 30px;
    border-radius: 16px;
    background: linear-gradient(120deg, var(--aurora-1), var(--aurora-2));
    color: #fff;
    font-weight: 600;
    box-shadow: 0 10px 32px -8px rgba(99, 102, 241, 0.55);
    transition: transform var(--tr-med), box-shadow var(--tr-med);
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 44px -8px rgba(99, 102, 241, 0.7);
  }
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: 13px 30px;
    border-radius: 16px;
    font-weight: 600;
    color: var(--fg-muted);
    transition: color var(--tr-fast), border-color var(--tr-fast), transform var(--tr-med);
  }
  .btn-ghost:hover {
    color: var(--fg);
    border-color: var(--glass-border-strong);
    transform: translateY(-2px);
  }

  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(20px, 5vw, 48px);
    margin: 56px auto 0;
    padding: 22px 40px;
    width: fit-content;
  }
  .stat {
    display: grid;
    justify-items: center;
    gap: 2px;
  }
  .stat-num {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 700;
    background: linear-gradient(120deg, var(--fg), var(--accent-strong));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stat-label {
    font-size: 0.8125rem;
    color: var(--fg-faint);
  }
  .stat-divider {
    width: 1px;
    height: 34px;
    background: var(--glass-border);
  }

  /* ── 文章区 ── */
  .posts-section {
    padding-top: var(--space-6);
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 28px;
  }
  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
  }
  .see-all {
    font-size: 0.9rem;
    color: var(--fg-faint);
    transition: color var(--tr-fast);
  }
  .see-all:hover {
    color: var(--accent-strong);
  }
  .see-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    cursor: pointer;
  }
  .see-all-kbd {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 1px 6px;
    border-radius: 6px;
    border: 1px solid var(--glass-border);
    color: inherit;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
  }
  .span-2 {
    grid-column: 1 / -1;
  }

  /* ── 首页专栏区 ── */
  .series-section {
    padding-top: var(--space-7);
  }
  .home-series-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 20px;
  }
  .hs-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 20px;
    cursor: pointer;
  }
  .hs-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .hs-icon {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    color: var(--accent-strong);
    background: rgba(129, 140, 248, 0.14);
  }
  .hs-count {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--fg-faint);
  }
  .hs-name {
    font-size: 1rem;
    font-weight: 700;
    margin: 0;
  }
  .hs-latest {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--fg-muted);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .hs-date {
    font-size: 0.75rem;
    color: var(--fg-faint);
    font-family: var(--font-mono);
  }

  @media (max-width: 1023px) {
    .home-series-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 767px) {
    .post-grid {
      grid-template-columns: 1fr;
    }
    .home-series-grid {
      grid-template-columns: 1fr;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-stats {
      padding: 18px 24px;
    }
  }
</style>
