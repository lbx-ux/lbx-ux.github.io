---
import { getPublishedPosts } from '@/lib/content';
import { estimateReadingTime } from '@/lib/readingTime';
import { buildSeriesMap } from '@/lib/series';
import PostCard from '@/components/PostCard.astro';
import Pagination from '@/components/Pagination.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { SITE_TITLE, SITE_DESCRIPTION, POSTS_PER_PAGE } from '@/consts';
import { PROJECTS } from '@/data/projects';

export async function getStaticPaths({ paginate }: import('astro').GetStaticPathsOptions) {
  const posts = await getPublishedPosts();
  return paginate(posts, { pageSize: POSTS_PER_PAGE });
}

const { page } = Astro.props;
// paginate 序列化只保留原始 entry，阅读时长在渲染期重算
const posts = page.data.map((p) => ({ ...p, readingMinutes: estimateReadingTime(p.body ?? '') }));
const featured = posts[0];
const rest = posts.slice(1);
const isFirstPage = page.currentPage === 1;

// 首页专栏区：全量文章分组，取最近更新的 4 个
const allPosts = isFirstPage
  ? (await getPublishedPosts()).map((p) => ({ ...p, readingMinutes: estimateReadingTime(p.body ?? '') }))
  : [];
const allSeries = isFirstPage ? buildSeriesMap(allPosts) : [];
const homeSeries = allSeries.slice(0, 4);

// 首页项目区：卡片上显示「关联站内笔记数」，篇数实时取自专栏分组
const seriesCount = new Map(allSeries.map((s) => [s.name, s.posts.length]));
const relatedNoteCount = (names: string[]) => names.reduce((n, s) => n + (seriesCount.get(s) ?? 0), 0);
---
<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  {isFirstPage && (
    <section class="hero container" data-hero>
      <p class="hero-eyebrow reveal" data-hero-eyebrow>PERSONAL BLOG</p>
      <h1 class="hero-title" data-hero-title>
        记录、思考、<br />与<em class="grad-text">技术</em>同行。
      </h1>
      <p class="hero-sub" data-hero-sub>
        {SITE_DESCRIPTION}
      </p>

      <div class="hero-actions" data-hero-card>
        <a class="btn-primary" href="#posts">开始阅读</a>
        <a class="btn-ghost glass" href="/about/">关于我</a>
      </div>

      <div class="hero-stats glass glass-sheen" data-hero-card>
        <div class="stat">
          <span class="stat-num">{page.total}+</span>
          <span class="stat-label">篇文章</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num">{allSeries.length}</span>
          <span class="stat-label">个专栏</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-num">∞</span>
          <span class="stat-label">好奇心</span>
        </div>
      </div>
    </section>
  )}

  <section class="container posts-section" id="posts">
    <div class="section-head reveal">
      <h2 class="section-title">最新文章</h2>
      <button type="button" class="see-all see-all-btn" data-search-open title="任意页面按 Ctrl+K 呼出搜索">
        全站搜索 <kbd class="see-all-kbd">Ctrl K</kbd> →
      </button>
    </div>

    <div class="post-grid" data-stagger>
      {
        isFirstPage && featured && (
          <div class="span-2">
            <PostCard post={featured} featured />
          </div>
        )
      }
      {rest.map((post) => <PostCard post={post} />)}
    </div>

    {page.lastPage > 1 && <Pagination current={page.currentPage} total={page.lastPage} baseUrl="/" />}
  </section>

  {
    isFirstPage && homeSeries.length > 0 && (
      <section class="container series-section reveal">
        <div class="section-head">
          <h2 class="section-title">技术专栏</h2>
          <a class="see-all" href="/series/">全部专栏 →</a>
        </div>
        <div class="home-series-grid" data-stagger>
          {
            homeSeries.map((s) => (
              <a class="hs-card glass glass-lift" href={`/series/${s.slug}/`}>
                <div class="hs-head">
                  <span class="hs-icon"><Icon name="layers" size={16} /></span>
                  <span class="hs-count">{s.posts.length} 篇</span>
                </div>
                <h3 class="hs-name">{s.name}</h3>
                <p class="hs-latest">首篇：{s.posts[0].data.title}</p>
              </a>
            ))
          }
        </div>
      </section>
    )
  }

  {
    isFirstPage &&
      PROJECTS.length > 0 && (
        <section class="container projects-section reveal">
          <div class="section-head">
            <h2 class="section-title">我的项目</h2>
            <a class="see-all" href="/projects/">全部项目 →</a>
          </div>
          <div class="home-projects-grid" data-stagger>
            {PROJECTS.map((p) => (
              <a class="hp-card glass glass-lift" href="/projects/">
                <div class="hp-head">
                  <span class="hp-icon"><Icon name="archive" size={16} /></span>
                  <span class="hp-repo">{p.repoName.split('/')[1]}</span>
                  <span class="hp-notes">{relatedNoteCount(p.relatedSeries)} 篇配套笔记</span>
                </div>
                <h3 class="hp-name">{p.title}</h3>
                <p class="hp-tag">{p.tagline}</p>
                {p.metrics && p.metrics.length > 0 && (
                  <div class="hp-metrics">
                    {p.metrics.slice(0, 2).map((m) => (
                      <span class="hp-metric">
                        <b>{m.value}</b>
                        <i>{m.short ?? m.label}</i>
                      </span>
                    ))}
                  </div>
                )}
              </a>
            ))}
          </div>
        </section>
      )
  }
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: clamp(24px, 6vh, 72px) 0 clamp(40px, 8vh, 96px);
    max-width: 860px;
    margin-inline: auto;
    text-align: center;
  }
  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.32em;
    color: var(--accent);
    margin: 0 0 20px;
  }
  .hero-title {
    font-size: clamp(2.4rem, 6.5vw, 4.2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    perspective: 600px;
  }
  .hero-title em {
    font-style: normal;
  }
  .hero-sub {
    margin: 24px auto 0;
    max-width: 560px;
    color: var(--fg-muted);
    font-size: 1.0625rem;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    margin-top: 36px;
  }
  .btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 13px 30px;
    border-radius: 16px;
    background: linear-gradient(120deg, var(--aurora-1), var(--aurora-2));
    color: #fff;
    font-weight: 600;
    box-shadow: 0 10px 32px -8px rgba(99, 102, 241, 0.55);
    transition: transform var(--tr-med), box-shadow var(--tr-med);
  }
  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 44px -8px rgba(99, 102, 241, 0.7);
  }
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: 13px 30px;
    border-radius: 16px;
    font-weight: 600;
    color: var(--fg-muted);
    transition: color var(--tr-fast), border-color var(--tr-fast), transform var(--tr-med);
  }
  .btn-ghost:hover {
    color: var(--fg);
    border-color: var(--glass-border-strong);
    transform: translateY(-2px);
  }

  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(20px, 5vw, 48px);
    margin: 56px auto 0;
    padding: 22px 40px;
    width: fit-content;
  }
  .stat {
    display: grid;
    justify-items: center;
    gap: 2px;
  }
  .stat-num {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 700;
    background: linear-gradient(120deg, var(--fg), var(--accent-strong));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stat-label {
    font-size: 0.8125rem;
    color: var(--fg-faint);
  }
  .stat-divider {
    width: 1px;
    height: 34px;
    background: var(--glass-border);
  }

  /* ── 文章区 ── */
  .posts-section {
    padding-top: var(--space-6);
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 28px;
  }
  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
  }
  .see-all {
    font-size: 0.9rem;
    color: var(--fg-faint);
    transition: color var(--tr-fast);
  }
  .see-all:hover {
    color: var(--accent-strong);
  }
  .see-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    cursor: pointer;
  }
  .see-all-kbd {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    padding: 1px 6px;
    border-radius: 6px;
    border: 1px solid var(--glass-border);
    color: inherit;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
  }
  .span-2 {
    grid-column: 1 / -1;
  }

  /* ── 首页专栏区 ── */
  .series-section {
    padding-top: var(--space-7);
  }
  .home-series-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-top: 20px;
  }
  .hs-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 18px 20px;
    cursor: pointer;
  }
  .hs-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .hs-icon {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    color: var(--accent-strong);
    background: rgba(129, 140, 248, 0.14);
  }
  .hs-count {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--fg-faint);
  }
  .hs-name {
    font-size: 1rem;
    font-weight: 700;
    margin: 0;
  }
  .hs-latest {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--fg-muted);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  /* ── 首页项目区 ── */
  .projects-section {
    padding-top: var(--space-7);
  }
  .home-projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: 20px;
  }
  .hp-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px 22px;
    cursor: pointer;
  }
  .hp-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .hp-icon {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    color: var(--accent-strong);
    background: rgba(129, 140, 248, 0.14);
    flex-shrink: 0;
  }
  .hp-repo {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--fg-muted);
  }
  .hp-notes {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--fg-faint);
    white-space: nowrap;
  }
  .hp-name {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0;
  }
  .hp-tag {
    margin: 0;
    font-size: 0.82rem;
    line-height: 1.65;
    color: var(--fg-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .hp-metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 2px;
  }
  .hp-metric {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: rgba(129, 140, 248, 0.07);
  }
  .hp-metric b {
    font-family: var(--font-mono);
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--accent-strong);
  }
  .hp-metric i {
    font-style: normal;
    font-size: 0.72rem;
    color: var(--fg-faint);
  }

  @media (max-width: 1023px) {
    .home-series-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 767px) {
    .post-grid {
      grid-template-columns: 1fr;
    }
    .home-series-grid,
    .home-projects-grid {
      grid-template-columns: 1fr;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-stats {
      padding: 18px 24px;
    }
  }
</style>
