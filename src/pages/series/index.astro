---
import { getPublishedPosts } from '@/lib/content';
import { estimateReadingTime } from '@/lib/readingTime';
import { buildSeriesMap, type SeriesGroup } from '@/lib/series';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';

const posts = (await getPublishedPosts()).map((p) => ({
  ...p,
  readingMinutes: estimateReadingTime(p.body ?? ''),
}));
const seriesList: (SeriesGroup & { readingMinutes: number })[] = buildSeriesMap(posts).map(
  (s) => ({
    ...s,
    // 专栏总阅读时长 = 成员之和（向上取整到 5 分钟粒度由 formatReadingTime 处理）
    readingMinutes: s.posts.reduce((sum, p) => sum + (p.readingMinutes || 0), 0),
  }),
);
---
<BaseLayout title="专栏" description="系列学习笔记专栏：算法、MySQL、Redis、SpringCloud，按学习路线有序组织。">
  <div class="container series-page">
    <header class="page-head reveal">
      <p class="page-eyebrow">SERIES</p>
      <h1 class="page-title">技术专栏</h1>
      <p class="page-sub">同一主题的笔记按学习路线串成专栏，顺着读就是一条完整路线。</p>
    </header>

    <div class="series-grid" data-stagger>
      {
        seriesList.map((s) => (
          <a class="series-card glass glass-lift glass-sheen" href={`/series/${s.slug}/`}>
            <div class="sc-head">
              <span class="sc-icon"><Icon name="layers" size={18} /></span>
              <span class="sc-count">{s.posts.length} 篇</span>
            </div>
            <h2 class="sc-name">{s.name}</h2>
            <ol class="sc-posts">
              {s.posts.slice(0, 3).map((p, i) => (
                <li>
                  <span class="sc-order">{p.data.order ?? i + 1}</span>
                  {p.data.title}
                </li>
              ))}
            </ol>
            {s.posts.length > 3 && <p class="sc-more">… 共 {s.posts.length} 篇</p>}
            <div class="sc-foot">
              <span><Icon name="clock" size={14} /> 约 {Math.round(s.readingMinutes / 5) * 5} 分钟</span>
            </div>
          </a>
        ))
      }
    </div>

    {seriesList.length === 0 && <p class="empty">还没有专栏文章</p>}
  </div>
</BaseLayout>

<style>
  .series-page {
    max-width: 1080px;
  }
  .page-head {
    margin-bottom: var(--space-6);
  }
  .page-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.32em;
    color: var(--accent);
    margin: 0 0 12px;
  }
  .page-title {
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 700;
  }
  .page-sub {
    margin: 12px 0 0;
    color: var(--fg-muted);
  }

  .series-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .series-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px 26px;
    cursor: pointer;
  }
  .sc-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .sc-icon {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    color: var(--accent-strong);
    background: rgba(129, 140, 248, 0.14);
  }
  .sc-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-faint);
  }
  .sc-name {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
  }
  .sc-posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
    font-size: 0.875rem;
    color: var(--fg-muted);
  }
  .sc-posts li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .sc-order {
    flex-shrink: 0;
    display: inline-grid;
    place-items: center;
    min-width: 22px;
    height: 20px;
    padding: 0 6px;
    border-radius: 7px;
    background: rgba(129, 140, 248, 0.14);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--accent-strong);
  }
  .sc-more {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--fg-faint);
  }
  .sc-foot {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px solid var(--border);
    font-size: 0.78rem;
    color: var(--fg-faint);
  }
  .sc-foot span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .empty {
    padding: 60px 0;
    text-align: center;
    color: var(--fg-faint);
  }

  @media (max-width: 767px) {
    .series-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
