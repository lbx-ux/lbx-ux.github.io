---
import { getPublishedPosts, formatDate } from '@/lib/content';
import { estimateReadingTime, formatReadingTime } from '@/lib/readingTime';
import { buildSeriesMap } from '@/lib/series';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';

export async function getStaticPaths() {
  const posts = (await getPublishedPosts()).map((p) => ({
    ...p,
    readingMinutes: estimateReadingTime(p.body ?? ''),
  }));
  return buildSeriesMap(posts).map((group) => ({
    params: { slug: group.slug },
    props: { group },
  }));
}

const { group } = Astro.props;
const totalMinutes = group.posts.reduce((sum, p) => sum + (p.readingMinutes || 0), 0);
---
<BaseLayout title={group.name} description={`专栏「${group.name}」共 ${group.posts.length} 篇笔记，按学习路线有序组织。`}>
  <div class="container series-detail">
    <header class="sd-head reveal">
      <p class="sd-eyebrow"><Icon name="layers" size={15} /> 专栏</p>
      <h1 class="sd-title">{group.name}</h1>
      <p class="sd-meta">
        共 {group.posts.length} 篇 · 总阅读约 {formatReadingTime(totalMinutes)} · 更新于 {formatDate(group.lastUpdated)}
      </p>
    </header>

    <ol class="sd-list" data-stagger>
      {
        group.posts.map((p, i) => (
          <li class="sd-item glass glass-lift">
            <span class="sd-order">{p.data.order ?? i + 1}</span>
            <div class="sd-main">
              <a class="sd-link" href={`/posts/${p.id}/`}>{p.data.title}</a>
              <p class="sd-desc">{p.data.description}</p>
            </div>
            <div class="sd-side">
              <time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
              <span>{formatReadingTime(p.readingMinutes)}</span>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>

<style>
  .series-detail {
    max-width: 820px;
  }
  .sd-head {
    margin-bottom: var(--space-6);
  }
  .sd-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.28em;
    color: var(--accent);
    margin: 0 0 12px;
  }
  .sd-title {
    font-size: clamp(2rem, 5vw, 2.6rem);
    font-weight: 700;
  }
  .sd-meta {
    margin: 12px 0 0;
    color: var(--fg-muted);
  }

  .sd-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .sd-item {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    padding: 20px 24px;
  }
  .sd-order {
    flex-shrink: 0;
    display: inline-grid;
    place-items: center;
    min-width: 40px;
    height: 32px;
    padding: 0 10px;
    border-radius: 10px;
    background: linear-gradient(120deg, rgba(99, 102, 241, 0.2), rgba(168, 85, 247, 0.16));
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--accent-strong);
  }
  .sd-main {
    flex: 1;
    min-width: 0;
  }
  .sd-link {
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.4;
  }
  .sd-link:hover {
    color: var(--accent-strong);
  }
  .sd-desc {
    margin: 6px 0 0;
    font-size: 0.875rem;
    color: var(--fg-muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sd-side {
    flex-shrink: 0;
    display: grid;
    gap: 4px;
    justify-items: end;
    font-size: 0.78rem;
    color: var(--fg-faint);
    font-family: var(--font-mono);
  }

  @media (max-width: 639px) {
    .sd-item {
      flex-direction: column;
      gap: 10px;
    }
    .sd-side {
      justify-items: start;
      flex-direction: row;
      gap: 14px;
    }
  }
</style>
