---
import { render } from 'astro:content';
import { getPublishedPosts, getRelatedPosts, getAdjacentPosts, formatDate } from '@/lib/content';
import { estimateReadingTime, formatReadingTime } from '@/lib/readingTime';
import { getPostSeries } from '@/lib/series';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { SITE_TITLE, SITE_AUTHOR } from '@/consts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
// 序列化后 readingMinutes 丢失，渲染期重算
post.readingMinutes = estimateReadingTime(post.body ?? '');
const allPosts = (await getPublishedPosts()).map((p) => ({
  ...p,
  readingMinutes: estimateReadingTime(p.body ?? ''),
}));
const { newer, older } = getAdjacentPosts(post, allPosts);
const related = getRelatedPosts(post, allPosts);
const { series, index } = getPostSeries(post, allPosts);
const seriesPrev = series && index > 0 ? series.posts[index - 1] : null;
const seriesNext = series && index >= 0 && index < series.posts.length - 1 ? series.posts[index + 1] : null;

// 从渲染后的标题集合生成 TOC（直接扫 Markdown 源更简单可靠）
interface TocItem {
  depth: number;
  slug: string;
  text: string;
}
const toc: TocItem[] = [];
const headingRegex = /^(#{2,3})\s+(.+)$/gm;
const body = post.body ?? '';
let match: RegExpExecArray | null;
const usedSlugs = new Set<string>();
while ((match = headingRegex.exec(body)) !== null) {
  const depth = match[1].length;
  const text = match[2].replace(/[`*_~\[\]]/g, '').trim();
  // GitHub slugger 兼容：小写、空格转连字符、去标点（含中文保留）
  let slug = text
    .toLowerCase()
    .replace(/[^\p{L}\p{N}\s-]/gu, '')
    .trim()
    .replace(/\s+/g, '-');
  if (usedSlugs.has(slug)) {
    let i = 1;
    while (usedSlugs.has(`${slug}-${i}`)) i++;
    slug = `${slug}-${i}`;
  }
  usedSlugs.add(slug);
  toc.push({ depth, slug, text });
}

const ogImage = 'og-default.png';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  author: { '@type': 'Person', name: SITE_TITLE },
  mainEntityOfPage: new URL(`/posts/${post.id}/`, Astro.site).href,
};
---
<BaseLayout title={post.data.title} description={post.data.description} ogImage={ogImage} jsonLd={jsonLd}>
  <div class="progress-track" aria-hidden="true"><div class="progress-bar" data-progress></div></div>

  <div class="container post-shell">
    <!-- ── 文章头 ── -->
    <header class="post-header reveal">
      <h1 class="post-title">{post.data.title}</h1>
      <div class="post-meta">
        <span class="meta-item">
          <Icon name="calendar" size={15} />
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        </span>
        <span class="meta-item">
          <Icon name="clock" size={15} />
          {formatReadingTime(post.readingMinutes)}
        </span>
        <span class="meta-item">
          <Icon name="user" size={15} />
          {SITE_AUTHOR}
        </span>
      </div>
    </header>

    <!-- ── 专栏横幅 ── -->
    {
      series && (
        <nav class="series-banner glass glass-sheen reveal" aria-label={`专栏：${series.name}`}>
          <div class="sb-row">
            <a class="sb-name" href={`/series/${series.slug}/`}>
              <Icon name="layers" size={16} />
              {series.name}
            </a>
            <span class="sb-progress">
              第 {post.data.order ?? index + 1} / {series.posts.length} 篇
            </span>
          </div>
          <div class="sb-dots" aria-hidden="true">
            {series.posts.map((p, i) => (
              <a
                class:list={['sb-dot', { 'is-done': i < index, 'is-current': i === index }]}
                href={`/posts/${p.id}/`}
                title={p.data.title}
              />
            ))}
          </div>
          {(seriesPrev || seriesNext) && (
            <div class="sb-nav">
              {seriesPrev ? (
                <a class="sb-link" href={`/posts/${seriesPrev.id}/`}>
                  <Icon name="arrow-left" size={14} /> 上一篇：{seriesPrev.data.title}
                </a>
              ) : (
                <span />
              )}
              {seriesNext && (
                <a class="sb-link sb-next" href={`/posts/${seriesNext.id}/`}>
                  下一篇：{seriesNext.data.title} <Icon name="arrow-right" size={14} />
                </a>
              )}
            </div>
          )}
        </nav>
      )
    }

    <!-- ── 正文 + TOC 双栏 ── -->
    <div class="post-columns">
      <article class="prose" data-article>
        <Content />
        <hr />
        <p class="post-end">— 完 —</p>
      </article>

      {
        toc.length > 1 && (
          <aside class="toc-rail" aria-label="目录">
            <nav class="toc glass" data-toc>
              <p class="toc-title">目录</p>
              <ul class="toc-list">
                {toc.map((item) => (
                  <li class:list={[`toc-depth-${item.depth}`]}>
                    <a href={`#${item.slug}`} data-toc-link>{item.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )
      }
    </div>

    <!-- ── 沉浸式阅读入口（覆盖层由 JS 挂到 body，见 animations.ts / prose.css） ── -->
    <button type="button" class="focus-entry glass glass-sheen" data-focus-enter>
      <Icon name="book-open" size={16} />
      沉浸式阅读
    </button>

    <!-- ── 上下篇 ── -->
    <nav class="post-nav" aria-label="相邻文章">
      {
        older && (
          <a class="pn-card glass glass-lift" href={`/posts/${older.id}/`}>
            <span class="pn-label"><Icon name="arrow-left" size={15} /> 更早一篇</span>
            <span class="pn-title">{older.data.title}</span>
          </a>
        )
      }
      {
        newer && (
          <a class="pn-card pn-next glass glass-lift" href={`/posts/${newer.id}/`}>
            <span class="pn-label">更新一篇 <Icon name="arrow-right" size={15} /></span>
            <span class="pn-title">{newer.data.title}</span>
          </a>
        )
      }
    </nav>

    <!-- ── 相关文章 ── -->
    {
      related.length > 0 && (
        <section class="related">
          <h2 class="related-title">相关文章</h2>
          <div class="related-grid" data-stagger>
            {related.map((p) => (
              <a class="rel-card glass glass-lift" href={`/posts/${p.id}/`}>
                <span class="rel-tag">{p.data.series ?? '文章'}</span>
                <span class="rel-title">{p.data.title}</span>
                <time class="rel-date" datetime={p.data.pubDate.toISOString()}>
                  {formatDate(p.data.pubDate)}
                </time>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  /* ── 阅读进度 ── */
  .progress-track {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 60;
    background: transparent;
  }
  .progress-bar {
    height: 100%;
    background: linear-gradient(90deg, var(--aurora-3), var(--aurora-1), var(--aurora-2));
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  .post-shell {
    max-width: 1160px;
  }

  /* ── 文章头 ── */
  .post-header {
    max-width: 820px;
    margin-inline: auto;
    text-align: center;
  }
  .post-title {
    font-size: clamp(1.8rem, 4.5vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.015em;
    line-height: 1.22;
  }
  .post-header .post-meta {
    justify-content: center;
    margin-top: 18px;
  }
  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  /* ── 专栏横幅 ── */
  .series-banner {
    max-width: 820px;
    margin: var(--space-6) auto 0;
    padding: 18px 24px;
    display: grid;
    gap: 12px;
  }
  .sb-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
  }
  .sb-name {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 1rem;
    color: var(--accent-strong);
  }
  .sb-name:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .sb-progress {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--fg-faint);
  }
  .sb-dots {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .sb-dot {
    width: 22px;
    height: 6px;
    border-radius: 4px;
    background: var(--glass-border);
    transition: background var(--tr-fast), transform var(--tr-fast);
  }
  .sb-dot:hover {
    transform: scaleY(1.6);
  }
  .sb-dot.is-done {
    background: linear-gradient(90deg, var(--aurora-3), var(--aurora-1));
    opacity: 0.65;
  }
  .sb-dot.is-current {
    background: linear-gradient(90deg, var(--aurora-1), var(--aurora-2));
    box-shadow: 0 0 10px rgba(129, 140, 248, 0.55);
  }
  .sb-nav {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .sb-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    font-size: 0.8125rem;
    color: var(--fg-muted);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    max-width: 48%;
  }
  .sb-link:hover {
    color: var(--accent-strong);
  }
  .sb-next {
    justify-content: flex-end;
  }

  /* ── 双栏 ── */
  .post-columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 44px;
    margin-top: var(--space-7);
    align-items: start;
  }
  .prose {
    max-width: 760px;
    margin-inline: auto;
    width: 100%;
  }
  .post-end {
    text-align: center;
    color: var(--fg-faint);
    letter-spacing: 0.4em;
  }

  .toc-rail {
    position: sticky;
    top: calc(var(--header-h) + 32px);
  }
  .toc {
    padding: 18px;
    max-height: calc(100dvh - var(--header-h) - 96px);
    overflow: auto;
  }

  /* ── 上下篇 ── */
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
    margin-top: var(--space-7);
  }
  .pn-card {
    display: grid;
    gap: 8px;
    padding: 20px 24px;
    cursor: pointer;
  }
  .pn-next {
    text-align: right;
  }
  .pn-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    color: var(--fg-faint);
  }
  .pn-next .pn-label {
    justify-content: flex-end;
  }
  .pn-title {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--fg);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── 相关文章 ── */
  .related {
    margin-top: var(--space-7);
  }
  .related-title {
    font-size: 1.3rem;
    margin-bottom: 20px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .rel-card {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 20px 22px;
    cursor: pointer;
  }
  .rel-tag {
    font-size: 0.75rem;
    color: var(--accent);
    font-family: var(--font-mono);
  }
  .rel-title {
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
  .rel-date {
    font-size: 0.8125rem;
    color: var(--fg-faint);
  }

  /* ── 沉浸式阅读入口（覆盖层样式在 prose.css，覆盖层由 JS 挂 body） ── */
  .focus-entry {
    position: fixed;
    right: 24px;
    bottom: 84px;
    z-index: 41; /* 返回顶部(40)上方，错开叠放 */
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border-radius: 16px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--fg-muted);
    opacity: 0;
    transform: translateY(16px);
    pointer-events: none;
    transition: opacity var(--tr-med), transform var(--tr-med), color var(--tr-fast),
      border-color var(--tr-fast), background var(--tr-med);
  }
  .focus-entry.is-visible {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .focus-entry:hover {
    color: var(--accent-strong);
    border-color: rgba(129, 140, 248, 0.45);
    background: var(--glass-bg-hover);
  }

  /* 沉浸模式下：正文成为覆盖层内唯一滚动主体，加宽列宽、字号微降提升单屏信息量 */
  :global(body.focus-reading) {
    overflow: hidden;
  }
  :global(body.focus-reading [data-article]) {
    max-width: min(1160px, 100% - 48px);
    margin-inline: auto;
    padding: 84px 0 120px;
    font-size: 1rem;
    line-height: 1.8;
  }
  :global(body.focus-reading [data-article] img) {
    margin-inline: auto;
    border-radius: 14px;
  }
  :global(body.focus-reading [data-article] .code-wrap) {
    box-shadow: 0 12px 36px -12px rgba(0, 0, 0, 0.4);
  }
  /* Flip 移动期间隐藏原位占位与页面其余部分，避免重排闪烁 */
  :global(body.focus-reading .post-header),
  :global(body.focus-reading .post-nav),
  :global(body.focus-reading .related),
  :global(body.focus-reading .toc-rail) {
    visibility: hidden;
  }

  @media (max-width: 1023px) {
    .post-columns {
      grid-template-columns: 1fr;
    }
    .toc-rail {
      position: static;
    }
    .toc {
      max-height: none;
    }
  }
  @media (max-width: 767px) {
    .post-nav {
      grid-template-columns: 1fr;
    }
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
